# Sanity Studio & API Configuration (Required)
NEXT_PUBLIC_SANITY_PROJECT_ID=5g37myau
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-01

# Sanity Secret Write Token (Required for production serverless lead writes)
# Generate from sanity.io/manage -> Project -> API -> Tokens (Editor permission)
SANITY_API_TOKEN=

# SMTP Email Configuration (Optional - for sending live lead emails to studio & client)
# Example for Gmail: smtp.gmail.com / port 465 (use an App Password)
# Example for Hostinger/cPanel: smtp.hostinger.com / port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
